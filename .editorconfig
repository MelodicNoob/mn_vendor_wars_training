# Top-level EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Lua-specific rules
[*.lua]
indent_style = space
indent_size = 2
tab_width = 2

# JSON files (keep 2 spaces for readability)
[*.json]
indent_style = space
indent_size = 2

# Markdown files (do not trim trailing whitespace)
[*.md]
trim_trailing_whitespace = false

# YAML files (2 spaces required)
[*.yml]
indent_style = space
indent_size = 2

# Git-related files
[*.{gitignore,gitattributes}]
indent_style = space
indent_size = 2
